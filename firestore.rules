rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn() && request.auth.uid == '9U83qO8u7IYuD4ocqdpxFRJY2Zl1';
    }

    match /students/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isTeacher());
      allow create, update: if signedIn() && request.auth.uid == studentId;
      allow delete: if false;
    }

    match /progress/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isTeacher());
      allow create, update: if signedIn() && (request.auth.uid == studentId || isTeacher());
      allow delete: if false;
    }
  }
}